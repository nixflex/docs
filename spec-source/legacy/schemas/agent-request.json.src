{
  "type": "object",
  "description": "Draft batch 2 contract. No required create fields. New create defaults: dynamic_greeting true, max_call_duration_seconds 300, silence_hangup_seconds 10, timezone valid account zone or UTC. Explicit valid values win. No existing agent is migrated. call_retention_days is rejected on create: account inheritance. Mixed unknown keys return warnings; unknown-only requests fail. Update is partial, never applies create defaults; empty updates fail. Pickup unchanged.",
  "properties": {
    "is_active": {"type":"boolean"},
    "ai_speaks_first": {"type":"boolean"},
    "dynamic_greeting": {"type":"boolean"},
    "func_end_call": {"type":"boolean","description":"Voice silence/duration timer gate, not a blanket prohibition on END_CALL."},
    "func_cold_transfer": {"type":"boolean","description":"Compatibility-only; not the effective transfer permission."},
    "func_send_sms": {"type":"boolean","description":"Compatibility-only; use incall_sms_enabled for in-call SMS."},
    "record_call": {"type":"boolean","description":"Agent recording default; an explicit number true/false wins."},
    "post_call_sms_enabled": {"type":"boolean"},
    "incall_sms_enabled": {"type":"boolean"},
    "amd_enabled": {"type":"boolean"},
    "greet_by_name": {"type":"boolean","description":"Inbound name-greeting hint, independent of remembering callers; not global anonymization."},
    "remember_callers": {"type":"boolean","description":"Phone caller context/learning; false does not erase saved records or website visitor history."},
    "require_booking_confirmation": {"type":"boolean"},
    "voicemail_leave_enabled": {"type":"boolean"},
    "name": {"type":"string","maxLength":200},
    "system_prompt": {"type":"string","maxLength":16000},
    "welcome_message": {"type":"string","maxLength":16000},
    "voice_id": {"type":"string","maxLength":200,"nullable":true},
    "voice_key": {"type":"string","maxLength":36,"nullable":true},
    "language": {"type":"string","maxLength":32},
    "webhook_url": {"type":"string","maxLength":2048,"nullable":true},
    "phone_number": {"type":"string","maxLength":32,"nullable":true},
    "llm_model": {"type":"string","maxLength":200,"description":"Compatibility-only; does not select the runtime model."},
    "fallback_message": {"type":"string","maxLength":16000,"description":"Compatibility-only; no current runtime consumer."},
    "post_call_sms_template": {"type":"string","maxLength":600},
    "transfer_number": {"type":"string","maxLength":32,"nullable":true},
    "transfer_whisper": {"type":"string","maxLength":16000,"nullable":true},
    "timezone": {"type":"string","maxLength":100},
    "boosted_keywords": {"type":"string","maxLength":2000,"nullable":true},
    "voicemail_message": {"type":"string","maxLength":600,"nullable":true},
    "temperature": {"type":"number","minimum":0,"maximum":0.7},
    "response_eagerness": {"type":"integer","minimum":0,"maximum":1000},
    "stt_confidence": {"type":"number","minimum":0,"maximum":1},
    "stt_max_silence_ms": {"type":"integer","minimum":0,"maximum":2147483647},
    "interruption_sensitivity": {"type":"integer","minimum":0,"maximum":100,"description":"Stored compatibility value; does not tune current interruption decisions."},
    "max_call_duration_seconds": {"type":"integer","minimum":1,"maximum":2147483,"nullable":true},
    "silence_hangup_seconds": {"type":"integer","minimum":1,"maximum":2147483,"nullable":true},
    "wait_tag_seconds": {"type":"integer","minimum":30,"maximum":120,"nullable":true},
    "ivr_timeout_seconds": {"type":"integer","minimum":1,"maximum":1800},
    "voice_speed": {"type":"number","minimum":0.01,"maximum":100,"description":"Compatibility-only; use speaking_rate."},
    "speaking_rate": {"oneOf":[{"type":"number","nullable":true},{"type":"string","enum":[""]}],"description":"Existing numeric clamp to 0.5..1.5. Null or empty clears."},
    "pickup_delay": {"description":"Legacy input handling and default (10) unchanged in this release."},
    "dtmf_enabled": {"type":"boolean","nullable":true},
    "response_length": {"type":"string","enum":["short","medium","long"]},
    "transfer_type": {"type":"string","enum":["cold","warm"]},
    "recording_source": {"type":"string","nullable":true,"description":"provider or nixflex (case/space normalized); null/empty clears to provider."},
    "data_extraction_fields": {"type":"array","maxItems":50,"items":{"$ref":"./agent-extraction.json"}}
  },
  "additionalProperties": true
}
