{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "feature",
    "title",
    "checked",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "feature": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "checked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "engine"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "engine": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "scope",
          "text",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "fixed",
              "unavailable",
              "does",
              "change",
              "limit",
              "api",
              "error"
            ]
          },
          "scope": {
            "enum": [
              "platform",
              "organisation",
              "account",
              "agent",
              "number",
              "call",
              "campaign",
              "recipient",
              "message",
              "thread",
              "session",
              "base",
              "source",
              "operation"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "instead": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_./@-]+:[1-9][0-9]*(-[1-9][0-9]*)?$"
            }
          },
          "sourceList": {
            "type": "string"
          },
          "value": {},
          "policy": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "fixed"
                }
              }
            },
            "then": {
              "required": [
                "why"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "unavailable"
                }
              }
            },
            "then": {
              "required": [
                "instead"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "api"
                }
              }
            },
            "then": {
              "required": [
                "value"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "error"
                }
              }
            },
            "then": {
              "required": [
                "value"
              ]
            }
          }
        ]
      }
    }
  }
}
