  "rules": [
    {
      "id": "agent-common",
      "kind": "fixed",
      "scope": "agent",
      "text": "For a different inbound opening on each number, use Dynamic greeting and put the opening in that number’s custom_prompt. Fixed welcome_message text, spoken language, pickup delay and general call timezone are shared agent settings. Use separate agents when those must differ. A booking timezone changes calendar times only.",
      "evidence": [
        "api/agents/input.js:2-13",
        "api/agentFields.js:18-31",
        "api/routes.js:1600-1633",
        "shared/integrations/googleCalendarSettings.js:7-17",
        "inbound/call/greeting.js:42-55",
        "inbound/call/greeting.js:29-56",
        "shared/data/agentPrompt.js:41-54"
      ],
      "why": "The fixed phone opener reads the agent’s saved welcome message."
    },
    {
      "id": "agent-default",
      "kind": "unavailable",
      "scope": "number",
      "text": "A number cannot override fixed agent settings.",
      "evidence": [
        "api/agents/input.js:2-13",
        "api/agentFields.js:18-31",
        "api/routes.js:1600-1633",
        "shared/integrations/googleCalendarSettings.js:7-17",
        "inbound/call/greeting.js:42-55"
      ],
      "instead": "Use its dynamic opening for business-specific wording. Use different agents for different fixed settings."
    },
    {
      "id": "agent-voice",
      "kind": "does",
      "scope": "number",
      "text": "Choose a complete primary and backup voice pair on the number. It overrides the agent pair as a whole. To use the saved agent pair, set voice_pair_inherit to true. A legacy voice_id can clear the agent’s catalogue key, and a partially migrated pair can be unavailable. Never choose by alias precedence.",
      "evidence": [
        "shared/tts/voicePair.js:2-18",
        "shared/tts/numberVoicePair.js:21-32",
        "shared/tts/voicePairLoader.js:26-36"
      ]
    },
