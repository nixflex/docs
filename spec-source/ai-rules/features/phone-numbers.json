  "rules": [
    {
      "id": "num-owner",
      "kind": "fixed",
      "scope": "account",
      "text": "A number belongs to the account and is assigned to an agent. An explicit outbound number must be eligible for that account and agent. On a shared agent always pass the intended customer’s from_number.",
      "why": "Without a selection the resolver orders eligible numbers by creation time and ID. The first number can belong to another customer of the same SaaS account.",
      "evidence": [
        "api/routes.js:1055-1078",
        "api/outboundNumber.js:13-31",
        "api/outboundNumber.js:37-48",
        "shared/features/numberMove.js:5-15"
      ]
    },
    {
      "id": "num-carrier",
      "kind": "fixed",
      "scope": "number",
      "text": "Use one complete carrier credential set from the customer’s carrier account. Only the carrier identifier and credential field names belong in the guide. Keep the values on your server.",
      "why": "Import validates the carrier identity. The public response projects approved fields and excludes private credentials.",
      "evidence": [
        "shared/features/numberImportInput.js:4-11",
        "shared/features/numberImportInput.js:22-37",
        "shared/features/numberOperationCarrier.js:9-22",
        "shared/features/numberReadProjection.js:2-12"
      ]
    },
    {
      "id": "num-no-tenant",
      "kind": "unavailable",
      "scope": "number",
      "text": "A number cannot set its own fixed welcome_message, language, general call timezone or pickup delay.",
      "instead": "Use Dynamic greeting with that number’s custom_prompt for its business opening. Select a separate agent for different agent settings.",
      "evidence": [
        "shared/features/phoneNumberImport.js:95-112",
        "shared/features/numberControls.js:2-4",
        "api/agents/input.js:2-13",
        "api/agentFields.js:18-31",
        "shared/integrations/googleCalendarSettings.js:7-17",
        "inbound/call/greeting.js:30-55"
      ]
    },
    {
      "id": "num-no-kb",
      "kind": "unavailable",
      "scope": "number",
      "text": "A number does not have an independently selectable knowledge base.",
      "instead": "Assign the number to an agent with the required knowledge.",
      "evidence": [
        "knowledge/agentOnly.js:3-12",
        "shared/features/numberMove.js:5-15"
      ]
    },
    {
      "id": "num-purpose",
      "kind": "does",
      "scope": "number",
      "text": "Import an existing supported carrier number, assign it to an owned agent, inspect it, change its channel controls and remove its Nixflex connection.",
      "evidence": [
        "api/routes.js:1548-1575",
        "api/routes.js:1583-1627",
        "api/numberReads.js:3-9",
        "shared/features/numberMove.js:5-15"
      ]
    },
    {
      "id": "num-import",
      "kind": "change",
      "scope": "number",
      "text": "Import server-side with POST /v1/phone-numbers. Supply phone_number and agent_id. Pair twilio_sid with twilio_token or telnyx_api_key with telnyx_connection_id. telnyx_public_key is optional for the latter. custom_prompt is optional.",
      "sourceList": "numbers.importFields",
      "value": [
        "phone_number",
        "agent_id",
        "twilio_sid",
        "twilio_token",
        "telnyx_api_key",
        "telnyx_connection_id",
        "telnyx_public_key",
        "custom_prompt"
      ],
      "evidence": [
        "shared/features/numberImportInput.js:4-11",
        "shared/features/numberImportInput.js:22-37"
      ]
    },
    {
      "id": "num-settings",
      "kind": "change",
      "scope": "number",
      "text": "These ordinary number settings are writable by PATCH. Text fields have individual clearing rules. Nullable recording and booking controls can inherit agent settings. Voicemail for an API-imported number uses the number’s controls.",
      "sourceList": "numbers.updateFields",
      "value": [
        "custom_prompt",
        "voice_id",
        "sms_reply_enabled",
        "sms_prompt",
        "web_prompt",
        "speaking_rate",
        "dtmf_enabled",
        "require_booking_confirmation",
        "record_call",
        "recording_source",
        "voicemail_leave_enabled",
        "voicemail_message"
      ],
      "evidence": [
