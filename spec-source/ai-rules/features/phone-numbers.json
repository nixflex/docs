  "rules": [
    {
      "id": "num-owner",
      "kind": "fixed",
      "scope": "account",
      "text": "A number belongs to an account and agent. On a shared agent always pass that customer’s eligible from_number.",
      "why": "Without a selection the resolver orders eligible numbers by creation time and ID. The first number can belong to another customer of the same SaaS account.",
      "evidence": [
        "api/routes.js:1059-1084",
        "api/outboundNumber.js:16-27",
        "shared/features/numberMove.js:5-15",
        "api/outboundNumber.js:65-85"
      ]
    },
    {
      "id": "num-carrier",
      "kind": "fixed",
      "scope": "number",
      "text": "Use one complete carrier credential set from the customer’s carrier account. Only the carrier identifier and credential field names belong in the guide. Keep the values on your server.",
      "why": "Import validates the carrier identity. The public response projects approved fields and excludes private credentials.",
      "evidence": [
        "shared/features/numberImportInput.js:4-11",
        "shared/features/numberImportInput.js:22-37",
        "shared/features/numberOperationCarrier.js:9-22",
        "shared/features/numberReadProjection.js:2-12"
      ]
    },
    {
      "id": "num-no-tenant",
      "kind": "unavailable",
      "scope": "number",
      "text": "Fixed welcome_message, language, general timezone and pickup delay belong to the agent.",
      "instead": "Use Dynamic greeting and the number’s custom_prompt for its opening. Split agents for different fixed settings.",
      "evidence": [
        "shared/features/phoneNumberImport.js:95-113",
        "shared/features/numberControls.js:2-4",
        "api/agents/input.js:2-13",
        "api/agentFields.js:18-31",
        "shared/integrations/googleCalendarSettings.js:7-17",
        "inbound/call/greeting.js:30-55"
      ]
    },
    {
      "id": "num-no-kb",
      "kind": "unavailable",
      "scope": "number",
      "text": "A number does not have an independently selectable knowledge base.",
      "instead": "Assign the number to an agent with the required knowledge.",
      "evidence": [
        "knowledge/agentOnly.js:3-12",
        "shared/features/numberMove.js:5-15"
      ]
    },
    {
      "id": "num-purpose",
