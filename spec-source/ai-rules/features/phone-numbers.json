    {
      "id": "num-import",
      "kind": "change",
      "scope": "number",
      "text": "Use POST /v1/phone-numbers on your server with the customer’s own `phone_number` and an active, owned `agent_id`. Send one complete pair. Twilio needs `twilio_sid` and `twilio_token`. Telnyx needs `telnyx_api_key` and `telnyx_connection_id` with optional `telnyx_public_key`. Keep secrets out of browsers and AI prompts. `custom_prompt` is optional.",
      "sourceList": "numbers.importFields",
      "value": [
        "phone_number",
        "agent_id",
        "twilio_sid",
        "twilio_token",
        "telnyx_api_key",
